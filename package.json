{
  "name": "am-pencari-preset",
  "version": "1.0.0",
  "private": true,
  "description": "AM Pencari Preset — TikTok preset finder, extractor & QR toolkit",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "framer-motion": "^14.2.0",
    "jsqr": "^1.4.0",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.30",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
