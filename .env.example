# ─────────────────────────────────────────────────────────────
# AM Pencari Preset — environment variables (copy to .env.local)
# NEVER put real secrets in NEXT_PUBLIC_* variables (they are sent to the browser).
# ─────────────────────────────────────────────────────────────

# ── Provider (server-only) ───────────────────────────────────
# Base URL of the TikWM API (https only). Default: https://www.tikwm.com
TIKWM_BASE_URL=https://www.tikwm.com
# Optional TikWM-compatible mirror/proxy used for keyword & creator search
# when the primary provider blocks those endpoints (must expose /api/feed/search & /api/user/posts).
SEARCH_FALLBACK_BASE_URL=
# Provider request timeout in ms (2000–20000). Default 10000
PROVIDER_TIMEOUT_MS=10000
# Minimum gap between provider calls in ms (TikWM free tier ≈ 1 req/s). Default 1100
PROVIDER_MIN_INTERVAL_MS=1100

# ── Cache / rate limit (server-only) ─────────────────────────
# In-memory LRU cache TTL in minutes (1–60). Default 12
CACHE_TTL_MINUTES=12
# Requests per minute per client for /api/* (burst = half of this). Default 30
RATE_LIMIT_PER_MINUTE=30
# Header your platform edge sets with the real client IP. Leave empty to NOT trust any
# forwarding header (all clients share one larger bucket). On Railway use: x-real-ip
TRUSTED_IP_HEADER=
# Shortlink resolver timeout in ms (clamped to 1000–5000). Default 4000
SHORTLINK_TIMEOUT_MS=4000
# Set to "false" to hide the X-Cache: HIT/MISS debug header
EXPOSE_CACHE_HEADER=true

# ── Build-time (applied during `next build`) ─────────────────
# iframe embedding policy (CSP frame-ancestors). Default: 'self'
FRAME_ANCESTORS=
# Public site URL used for Open Graph absolute URLs, e.g. https://am-preset.up.railway.app
NEXT_PUBLIC_SITE_URL=

# ── Community & donation links (public, build-time) ──────────
# Leave empty to show a "belum dikonfigurasi" placeholder. Only these hosts are accepted:
# chat.whatsapp.com / wa.me, t.me, saweria.co, trakteer.id
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_SAWERIA_URL=
NEXT_PUBLIC_TRAKTEER_URL=
